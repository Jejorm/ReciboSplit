# Copy to .env for local dev (never commit .env itself).
# Local dev default (matches frontend/src/api.js's fallback):
VITE_API_URL=http://localhost:8000

# In production, set VITE_API_URL to the deployed Render backend URL
# (e.g. https://recibosplit-api.onrender.com) as a build-time env var in
# Cloudflare Pages' project settings — Vite inlines import.meta.env.VITE_*
# values at build time, so this must be set before the Pages build runs,
# not read at request time.
