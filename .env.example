# Copy to .env for local dev (never commit .env itself — see .gitignore).
# In production (Render) these are set as service env vars instead, not via
# this file.

# Turso (libSQL) credentials for db.py. If both are unset, db.py falls back
# to a plain local SQLite file (no remote sync) — fine for local dev, but
# TURSO_DATABASE_URL/TURSO_AUTH_TOKEN are required in production.
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Optional: local replica filename for db.py (default: recibosplit.db).
# RECIBOSPLIT_DB_PATH=recibosplit.db

# OpenAI vision extraction (Phase 2, vision.py). Read by the `openai` SDK's
# OpenAI() client via this exact env var name.
OPENAI_API_KEY=sk-your-openai-api-key

# CORS: the deployed frontend origin (Cloudflare Pages), e.g.
# https://recibosplit.pages.dev. Not required for local dev — main.py
# already allows http://localhost:5173 by default.
FRONTEND_ORIGIN=http://localhost:5173
